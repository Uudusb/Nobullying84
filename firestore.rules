rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isSignedIn() && email() == 'uudusbayarsaikhan@gmail.com';
    }

    function isDundAdmin() {
      return isSignedIn() && email() == 'damchiibadgarsaranbileg@gmail.com';
    }

    function isAkhlakhAdmin() {
      return isSignedIn() && email() == 'azaa.m0623@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || isDundAdmin() || isAkhlakhAdmin();
    }

    function canReadReport() {
      return isSuperAdmin()
        || (isDundAdmin() && resource.data.schoolLevel == 'Дунд анги')
        || (isAkhlakhAdmin() && resource.data.schoolLevel == 'Ахлах анги');
    }

    // Full reports: students create; only admins read/update status
    match /reports/{code} {
      allow create: if code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.status == 'Хянагдаж байна'
        && request.resource.data.schoolLevel in ['Дунд анги', 'Ахлах анги']
        && request.resource.data.keys().hasAll([
          'code', 'status', 'schoolLevel', 'createdAt'
        ]);

      allow get, list: if canReadReport();

      allow update: if canReadReport()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // Public tracking: only status metadata, no student PII
    match /publicStatus/{code} {
      allow get: if true;
      allow list: if false;

      allow create: if code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['code', 'status', 'date'])
        && request.resource.data.code == code
        && (
          request.resource.data.status == 'Хянагдаж байна'
          || isAdmin()
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'date'])
        && request.resource.data.code == resource.data.code;

      allow delete: if false;
    }

    // Optional admin profile docs (no passwords). Write only via Console.
    match /admins/{docId} {
      allow read: if isSignedIn() && (docId == request.auth.uid || docId == email());
      allow write: if false;
    }
  }
}
